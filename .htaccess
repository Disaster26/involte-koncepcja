Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

RewriteEngine On
RewriteBase /

# jedna wersja adresu: https://involte.pl (bez www)
RewriteCond %{HTTP_HOST} ^www\.involte\.pl$ [NC]
RewriteRule ^ http://involte.pl%{REQUEST_URI} [R=301,L]
#HTTPS RewriteCond %{HTTPS} !=on
#HTTPS RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#HTTPS RewriteCond %{HTTP_HOST} ^involte\.pl$ [NC]
#HTTPS RewriteRule ^ https://involte.pl%{REQUEST_URI} [R=301,L]

# stare adresy WordPressa (?page_id=, ?p=)
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=106(&|$)
RewriteRule ^(index\.php)?$ /? [R=301,L]
